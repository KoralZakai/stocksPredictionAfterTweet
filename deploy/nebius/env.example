# Copy to deploy/nebius/.env and fill in. NEVER commit the filled copy.
# `.env` and `.env.*` are already gitignored.

# --- Nebius project / network -------------------------------------------------
# nebius iam whoami                       -> your identity
# nebius iam project list                 -> NB_PROJECT_ID (project-...)
# nebius vpc subnet list --parent-id ...  -> NB_SUBNET_ID  (vpcsubnet-...)
NB_PROJECT_ID=project-xxxxxxxxxxxxxxxxxx
NB_SUBNET_ID=vpcsubnet-xxxxxxxxxxxxxxxxxx

# --- Compute ------------------------------------------------------------------
# CPU-only (classical-ML track; §12). Verify what your project offers with:
#   nebius compute platform list --parent-id "$NB_PROJECT_ID"
# cpu-e2 = Intel Ice Lake (eu-north1); cpu-d3 = AMD EPYC Genoa.
NB_PLATFORM=cpu-e2
NB_PRESET=2vcpu-8gb
NB_TIMEOUT=1h

# --- Container image ----------------------------------------------------------
# Any registry Nebius can pull from. Format: registry/path:tag
NB_IMAGE=cr.eu-north1.nebius.cloud/<registry-id>/tweet-signal:v1
NB_REGISTRY_USERNAME=
NB_REGISTRY_PASSWORD=

# --- Shared artifact store ----------------------------------------------------
# Jobs chain by artifact I/O. Mounted into every job at /data.
NB_BUCKET=my-tweet-signal-bucket

# --- Endpoint -----------------------------------------------------------------
# Token auth for /predict. Generate with: openssl rand -hex 32
NB_ENDPOINT_TOKEN=

# --- Optional: real Claude signals in the llm_features job ---------------------
# Leave unset and the job uses the deterministic HeuristicExtractor instead.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8
