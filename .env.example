# Copy to .env (gitignored) and fill in. NEVER commit the filled copy.
# `.env` and `.env.*` are already in .gitignore.
#
# Only the NEBIUS_* block is required. Everything else is optional and the
# pipeline degrades cleanly without it (see data/PROVENANCE.md).

# --- Nebius LLM (REQUIRED) ----------------------------------------------------
# OpenAI-compatible /chat/completions. Get a key at https://studio.nebius.ai
# The code also accepts the EXPO_PUBLIC_NEBIUS_* aliases.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --- Alpaca intraday (OPTIONAL) -----------------------------------------------
# Only needed to (re)generate the 30m/1h diagnostic horizons and the market
# plane's live quotes. Free paper key works: https://app.alpaca.markets
# WITHOUT these, the batch job skips intraday horizons and the endpoint's
# market provider falls back to yfinance, then to a null provider. The shipped
# EOD decision horizon never depends on Alpaca.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Fallback names some scripts read (either pair works):
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=
